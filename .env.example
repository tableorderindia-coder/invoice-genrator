# Neon PostgreSQL (via Vercel Marketplace or self-hosted)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Secret for signing session cookies (lib/auth/session.ts)
SESSION_SECRET=replace-with-a-long-random-secret

# URL of the v2 portal (the "pnl-tracker-test" rebuild). Linked from the
# sidebar's "Switch to v2" button (app/_components/shell.tsx). Optional -
# falls back to the current Vercel deployment URL if unset.
NEXT_PUBLIC_V2_PORTAL_URL=https://pnl-tracker-test.vercel.app
