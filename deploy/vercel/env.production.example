NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Neon (via Vercel Marketplace) - the pooled connection string it provisions.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Secret used to HMAC-sign session cookies (lib/auth/session.ts). Generate
# with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
